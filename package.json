{
  "name": "candor",
  "private": true,
  "version": "0.4.0",
  "description": "Local-first desktop meeting recorder with on-device transcription and AI.",
  "author": {
    "name": "Candor",
    "email": "danielmss99@users.noreply.github.com"
  },
  "desktopName": "Candor",
  "license": "MIT",
  "main": "dist-v3/electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "node scripts/electron-dev.mjs --dev",
    "dev:install-local-ai": "node scripts/install-development-ai-bundle.mjs --acknowledge-local-development",
    "build": "npm run electron:v3:build",
    "start": "node scripts/electron-dev.mjs --start",
    "dist": "npm run electron:v3:dist",
    "preview": "npm run build && npm run start",
    "test": "vitest run",
    "test:electron": "npm run v3:visual-fixtures:build && playwright test -c playwright.electron.config.ts",
    "test:electron:build": "npm run electron:v3:build && npm run test:electron",
    "core:v3:build": "node scripts/cargo-with-local-perl.mjs build --manifest-path crates/candor-core/Cargo.toml",
    "core:v3:release": "node scripts/build-release-core.mjs",
    "electron:v3:build-main": "node scripts/m0-build-electron.mjs",
    "electron:v3:typecheck-renderer": "tsc -p v3/renderer/tsconfig.json",
    "electron:v3:build-renderer": "vite build -c vite.v3.config.ts",
    "v3:visual-fixtures:build": "vite build -c vite.visual.config.ts",
    "electron:v3:build": "npm run spec3:ai-bundle:verify:self-test && npm run release:publication-policy:self-test && npm run spec3:ai-bundle:verify && npm run v3:icons:check && npm run core:v3:release && npm run electron:v3:build-main && npm run electron:v3:build-renderer",
    "electron:v3:pack": "npm run electron:v3:build && electron-builder --config electron-builder.source-interface.yml --dir",
    "electron:v3:dist": "npm run electron:v3:build && electron-builder --config electron-builder.source-interface.yml",
    "electron:v3:dist:win": "npm run electron:v3:build && electron-builder --config electron-builder.source-interface.yml --win nsis --x64",
    "electron:v3:dist:mac": "npm run electron:v3:build && electron-builder --config electron-builder.source-interface.yml --mac dmg",
    "electron:v3:dist:linux": "npm run electron:v3:build && electron-builder --config electron-builder.source-interface.yml --linux AppImage deb",
    "electron:v3:dist:ai-release": "npm run release:complete",
    "package:dev": "npm run electron:v3:pack",
    "package:source-interface": "npm run electron:v3:dist",
    "package:standard": "node scripts/spec3-verify-ai-bundle.mjs --require-ready --profile complete && npm run electron:v3:build && electron-builder --config electron-builder.v3.yml --dir",
    "release:standard": "node scripts/spec3-verify-ai-bundle.mjs --require-ready --profile complete && npm run release:signing-config:verify && npm run electron:v3:build && electron-builder --config electron-builder.release.cjs && npm run release:publication-gate",
    "package:maximum-pack": "node scripts/spec3-verify-ai-bundle.mjs --require-ready --profile complete-max && npm run electron:v3:build && electron-builder --config electron-builder.v3.yml --dir",
    "release:maximum-pack": "node scripts/spec3-verify-ai-bundle.mjs --require-ready --profile complete-max && npm run release:signing-config:verify && npm run electron:v3:build && electron-builder --config electron-builder.release.cjs && npm run release:publication-gate",
    "release:complete": "npm run release:standard",
    "release:complete-max": "npm run release:maximum-pack",
    "release:acquire-model": "node scripts/spec6-acquire-release-model.mjs",
    "release:publication-policy": "node scripts/spec6-release-publication-gate.mjs --allow-empty",
    "release:publication-policy:self-test": "node scripts/spec6-release-publication-gate.mjs --self-test",
    "release:publication-gate": "npm run v3:release-readiness-audit:strict && node scripts/spec6-release-publication-gate.mjs",
    "release:signing-config:verify": "node scripts/spec6-release-signing-config.mjs",
    "electron:v3:start": "node scripts/electron-dev.mjs --start",
    "v3:icons": "node scripts/generate-v3-icons.mjs",
    "v3:icons:check": "node scripts/generate-v3-icons.mjs --check",
    "v3:icon-proof": "node scripts/v3-icon-proof.mjs",
    "v3:verify": "node scripts/v3-verify.mjs",
    "v3:identity:verify": "node scripts/verify-product-identity.mjs",
    "v3:verify-main-architecture": "node scripts/verify-main-architecture.mjs",
    "v3:sbom": "node scripts/v3-release-sbom.mjs",
    "v3:sbom:verify": "node scripts/v3-release-sbom.mjs --verify",
    "v3:dependency-audit": "npm audit --audit-level=high && cargo audit --file crates/candor-core/Cargo.lock",
    "v3:source-security-proof": "node scripts/v3-source-security-proof.mjs",
    "v3:source-security-proof:self-test": "node scripts/audit-source-security.mjs --self-test",
    "v3:updater-policy-proof": "node scripts/v3-updater-policy-proof.mjs",
    "v3:release-artifact-smoke": "node scripts/v3-release-artifact-smoke.mjs",
    "v3:release-artifact-smoke:strict": "node scripts/v3-release-artifact-smoke.mjs --strict",
    "v3:release-checksums": "node scripts/v3-release-checksums.mjs",
    "v3:release-checksums:verify": "node scripts/v3-release-checksums.mjs --verify",
    "v3:release-signing-proof": "node scripts/v3-release-signing-proof.mjs",
    "v3:release-signing-proof:strict": "node scripts/v3-release-signing-proof.mjs --strict",
    "v3:manual-release-matrix": "node scripts/v3-manual-release-matrix.mjs",
    "v3:manual-release-matrix:strict": "node scripts/v3-manual-release-matrix.mjs --strict",
    "v3:release-readiness-audit": "node scripts/v3-release-readiness-audit.mjs",
    "v3:release-readiness-audit:strict": "node scripts/v3-release-readiness-audit.mjs --strict",
    "v3:goal-audit": "node scripts/v3-goal-audit.mjs",
    "v3:goal-audit:strict": "node scripts/v3-goal-audit.mjs --strict",
    "m0:verify": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/m0-verify.ps1",
    "m0:local-proof-refresh": "node scripts/m0-local-proof-refresh.mjs",
    "m0:packaged-smoke": "node scripts/m0-packaged-smoke.mjs",
    "m0:network-deny:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/m0-network-deny-windows.ps1",
    "m0:network-deny:windows:admin": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/m0-network-deny-windows-admin.ps1",
    "m0:network-deny:linux": "node scripts/m0-network-deny-linux.mjs",
    "m0:network-deny:macos": "node scripts/m0-network-deny-macos.mjs",
    "m0:artifact-manifest": "node scripts/m0-artifact-manifest.mjs",
    "m0:proof-audit": "node scripts/m0-proof-audit.mjs",
    "m0:proof-audit:self-test": "node scripts/m0-proof-audit.mjs --self-test",
    "m0:proof-audit:strict": "node scripts/m0-proof-audit.mjs --strict",
    "m0:ci-contract-smoke": "node scripts/m0-ci-contract-smoke.mjs",
    "m1:durable-recording-smoke": "node scripts/m1-durable-recording-smoke.mjs",
    "m1:durable-crash-smoke": "node scripts/m1-durable-crash-recovery-smoke.mjs",
    "m1:consent-smoke": "node scripts/m1-consent-smoke.mjs",
    "m1:macos-privacy-contract-smoke": "node scripts/m1-macos-privacy-contract-smoke.mjs",
    "m1:capture-service-smoke": "node scripts/m1-capture-service-smoke.mjs",
    "m1:capture-proof-audit": "node scripts/m1-capture-proof-audit.mjs",
    "m1:capture-proof-audit:real": "node scripts/m1-capture-proof-audit.mjs --require-real mic,system,combined",
    "m1:real-capture-readiness": "node scripts/m1-real-capture-readiness-audit.mjs",
    "m1:real-capture-readiness:record": "node scripts/m1-real-capture-readiness-audit.mjs --record-only",
    "m1:real-capture-proof": "node scripts/m1-real-capture-proof.mjs",
    "m1:real-capture-proof:record": "node scripts/m1-real-capture-proof.mjs --record-only",
    "m1:capture-crash-smoke": "node scripts/m1-capture-crash-recovery-smoke.mjs",
    "m1:bootstrap-native-perl": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/m1-bootstrap-native-perl-windows.ps1",
    "m1:vault-smoke": "node scripts/m1-vault-smoke.mjs",
    "m1:verify": "npm run core:v3:build && npm run m1:durable-recording-smoke && npm run m1:durable-crash-smoke && npm run m1:consent-smoke && npm run m1:macos-privacy-contract-smoke && npm run m1:capture-service-smoke && npm run m1:capture-proof-audit && npm run m1:capture-crash-smoke",
    "m1:verify:sqlcipher": "node scripts/cargo-with-local-perl.mjs build --manifest-path crates/candor-core/Cargo.toml --features sqlcipher-vault && npm run m1:vault-smoke",
    "m2:local-library-smoke": "node scripts/m2-local-library-export-smoke.mjs",
    "m2:audio-replay-smoke": "node scripts/m2-audio-replay-smoke.mjs",
    "m2:local-model-scheduler-smoke": "node scripts/m2-local-model-scheduler-smoke.mjs",
    "m2:local-wav-fixture": "node scripts/m2-local-wav-fixture.mjs",
    "m2:local-wav-fixture:record": "node scripts/m2-local-wav-fixture.mjs --record-only",
    "m2:real-whisper-inputs": "node scripts/m2-real-whisper-inputs.mjs",
    "m2:real-whisper-inputs:record": "node scripts/m2-real-whisper-inputs.mjs --record-only",
    "m2:transcription-boundary-smoke": "node scripts/m2-transcription-boundary-smoke.mjs",
    "m2:transcription-boundary-smoke:real": "npm run core:v3:release && node scripts/m2-transcription-boundary-smoke.mjs --real-local",
    "m2:transcription-proof-audit": "node scripts/m2-transcription-proof-audit.mjs",
    "m2:transcription-proof-audit:real": "node scripts/m2-transcription-proof-audit.mjs --require-real-local",
    "m2:real-whisper-proof": "node scripts/m2-real-whisper-proof.mjs",
    "m2:real-whisper-proof:record": "node scripts/m2-real-whisper-proof.mjs --record-only",
    "m2:model-manager-smoke": "node scripts/m2-model-manager-smoke.mjs",
    "m2:whisper-preflight": "node scripts/m2-local-whisper-preflight.mjs",
    "m2:whisper-preflight:record": "node scripts/m2-local-whisper-preflight.mjs --record-only",
    "m2:verify": "npm run core:v3:build && npm run m2:local-library-smoke && npm run m2:audio-replay-smoke && npm run m2:local-model-scheduler-smoke && npm run m2:model-manager-smoke && npm run m2:transcription-boundary-smoke && npm run m2:whisper-preflight && npm run m2:transcription-proof-audit",
    "m3:product-surface-smoke": "node scripts/m3-product-surface-smoke.mjs",
    "m3:verify": "npm run core:v3:build && npm run m3:product-surface-smoke && npm run electron:v3:typecheck-renderer",
    "m4:heuristic-recap-smoke": "node scripts/m4-heuristic-recap-smoke.mjs",
    "m4:instruct-asset-manager-smoke": "node scripts/m4-instruct-asset-manager-smoke.mjs",
    "m4:local-instruct-preflight": "node scripts/m4-local-instruct-preflight.mjs",
    "m4:local-instruct-preflight:strict": "node scripts/m4-local-instruct-preflight.mjs --strict-ready",
    "m4:local-instruct-fixture": "node scripts/m4-local-instruct-fixture-smoke.mjs",
    "m4:real-local-instruct-proof": "npm run core:v3:release && node scripts/m4-real-local-instruct-proof.mjs --core build/core-bin/candor-core.exe",
    "m4:real-local-instruct-proof:allow-missing": "npm run core:v3:build && node scripts/m4-real-local-instruct-proof.mjs --allow-missing",
    "m4:real-local-instruct-proof:self-test": "node scripts/m4-real-local-instruct-proof.mjs --self-test",
    "m4:verify": "npm run core:v3:build && npm run m4:heuristic-recap-smoke && npm run m4:instruct-asset-manager-smoke && npm run m4:local-instruct-preflight && npm run m4:local-instruct-fixture && npm run m4:real-local-instruct-proof:self-test",
    "spec3:ai-bundle:verify": "node scripts/spec3-verify-ai-bundle.mjs",
    "spec3:ai-bundle:verify:strict": "node scripts/spec3-verify-ai-bundle.mjs --require-ready",
    "spec3:ai-bundle:verify:complete": "node scripts/spec3-verify-ai-bundle.mjs --require-ready --profile complete",
    "spec3:ai-bundle:verify:complete-max": "node scripts/spec3-verify-ai-bundle.mjs --require-ready --profile complete-max",
    "spec3:ai-bundle:verify:self-test": "node scripts/spec3-verify-ai-bundle.mjs --self-test",
    "spec3:packaged-ai-smoke": "node scripts/spec3-packaged-ai-smoke.mjs",
    "m5:v2-import-smoke": "node scripts/m5-v2-import-smoke.mjs",
    "m5:verify": "npm run core:v3:build && npm run m5:v2-import-smoke",
    "audit:source": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/audit-source-security.ps1",
    "audit:source:portable": "node scripts/audit-source-security.mjs",
    "audit:release": "npm run audit:source && powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/audit-release-artifacts.ps1"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/space-grotesk": "^5.2.10",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "lucide-react": "^1.24.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.185.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "^4.6.0",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "js-yaml": "^4.3.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.9"
  }
}
