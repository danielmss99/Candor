# Candor does not require an environment file for normal local development.
# This file documents optional shell variables used by strict local proofs.
# The Electron launcher does not automatically load .env files.

# Optional development-only license mock. Production builds must leave this off.
CANDOR_ENABLE_MOCK_LICENSE=0

# Optional path override for isolated tests and proof scripts only.
# CANDOR_V3_DATA_DIR=C:\path\to\isolated-proof-data

# Real local llama.cpp proof inputs. Paths stay in the main/core process and are
# never returned to the renderer. Hashes are required for strict proof.
# CANDOR_LOCAL_LLM_BINARY=C:\path\to\llama-cli.exe
# CANDOR_LOCAL_LLM_BINARY_SHA256=<64-hex-sha256>
# CANDOR_LOCAL_LLM_MODEL=C:\path\to\model.gguf
# CANDOR_LOCAL_LLM_MODEL_SHA256=<64-hex-sha256>
# CANDOR_LOCAL_LLM_DISTRIBUTION_ARCHIVE=C:\path\to\llama-distribution.zip
# CANDOR_LOCAL_LLM_DISTRIBUTION_SHA256=<64-hex-sha256>
# CANDOR_LOCAL_LLM_CONTEXT_TOKENS=4096

# Optional public Whisper integrity pins supplied at Rust compile time. The core
# already contains reviewed defaults for supported model IDs.
CANDOR_SHA256_TINY_EN=921E4CF8686FDD993DCD081A5DA5B6C365BFDE1162E72B08D75AC75289920B1F
CANDOR_SHA256_BASE_EN=A03779C86DF3323075F5E796CB2CE5029F00EC8869EEE3FDFB897AFE36C6D002
CANDOR_SHA256_SMALL_EN=C6138D6D58ECC8322097E0F987C32F1BE8BB0A18532A3F88F734D1BBF9C41E5D
